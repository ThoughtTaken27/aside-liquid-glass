{
  "name": "aside-miniapp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev -w @aside-miniapp/server",
    "dev:web": "npm run dev -w @aside-miniapp/web",
    "build": "npm run build -w @aside-miniapp/web && npm run build -w @aside-miniapp/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "start": "node server/dist/index.js",
    "initdata": "node scripts/dev-initdata.mjs",
    "setup": "npm ci && npm run build && npm run doctor -- --setup",
    "doctor": "node scripts/doctor.mjs",
    "launchd": "node scripts/install-launchd.mjs",
    "frontdoor": "bash frontdoor/install.sh",
    "test:visual-browser": "node server/scripts/test-visual-browser.mjs"
  },
  "devDependencies": {
    "chart.js": "4.6.1",
    "concurrently": "^9.1.2",
    "d3": "7.9.0",
    "esbuild": "0.25.12",
    "playwright": "1.62.1",
    "three": "0.170.0"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
